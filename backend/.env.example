# Copy this file to .env and fill in your keys. .env is gitignored.
# Both keys stay server-side only - never sent to the mobile client.
OPENAI_API_KEY=
BRAVE_SEARCH_API_KEY=
# Google OAuth web-client credentials (server-side only).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/connect/google/callback
# Generate once with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
GOOGLE_TOKEN_ENCRYPTION_KEY=
