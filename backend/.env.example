# Copy this file to .env and fill in your keys. .env is gitignored.
# All keys stay server-side only - never sent to the mobile client.
DATABASE_URL=
OPENAI_API_KEY=
BRAVE_SEARCH_API_KEY=
# Google OAuth web-client credentials (server-side only).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/connect/google/callback
# Generate once with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
GOOGLE_TOKEN_ENCRYPTION_KEY=

# --- LLM routing (see backend/app/llm.py) ---
# Everything defaults to OpenAI gpt-4o-mini; nothing below changes behavior until it is set.
# Optional model override for OpenAI.
OPENAI_MODEL=
# DeepSeek (open-weight, OpenAI-compatible). Text + tool calling + image input; no strict json_schema.
# deepseek-flash is the cheap all-rounder for every task; deepseek-v4-pro costs 2-4x more, no vision.
# (deepseek-chat / deepseek-reasoner are retired.)
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
# Thinking mode is on by default at DeepSeek and breaks planner tool calls, so it is sent as
# disabled unless you set this to 1.
DEEPSEEK_THINKING=
# Any other OpenAI-compatible endpoint, to try an arbitrary open-weight model (Together, Groq,
# OpenRouter, local Ollama/vLLM...). Needs base URL + model; key is optional for local servers.
# Set OPEN_WEIGHT_VISION=1 only if the model accepts images (e.g. a Qwen-VL).
OPEN_WEIGHT_BASE_URL=
OPEN_WEIGHT_API_KEY=
OPEN_WEIGHT_MODEL=
OPEN_WEIGHT_VISION=
# Which provider serves what: openai | deepseek | openweight. Blank = openai.
LLM_PROVIDER=
# Per-task overrides. Tasks: PLANNER (phone-control tool calling), ANALYZE (finance summary),
# RECOVERY (replay recovery), VISION (receipt reading - only ever routed to vision-capable providers:
# openai, deepseek, or an open-weight model with OPEN_WEIGHT_VISION=1).
# e.g. LLM_PROVIDER_ANALYZE=deepseek   LLM_MODEL_ANALYZE=deepseek-flash
LLM_PROVIDER_PLANNER=
LLM_PROVIDER_ANALYZE=
LLM_PROVIDER_RECOVERY=
LLM_PROVIDER_VISION=
LLM_MODEL_PLANNER=
LLM_MODEL_ANALYZE=
LLM_MODEL_RECOVERY=
LLM_MODEL_VISION=
# Default on: if a task's provider errors, retry on the next configured one. Set to 0 while
# comparing models so a failure isn't silently masked by a retry on another provider.
LLM_FALLBACK=1
