# Copy this file to .env and fill in your key. .env is gitignored.
#
# SECURITY: This key is bundled into the client app (EXPO_PUBLIC_ vars are
# inlined into the JS bundle at build time and are extractable from the APK).
# Acceptable for this local, personal dev-only tool bench. Do not ship this
# pattern to any real distribution - move the OpenAI call behind a backend
# proxy first. See src/planner/openaiPlanner.ts.
EXPO_PUBLIC_OPENAI_API_KEY=
