# Copy this file to .env and fill in values. .env is gitignored.
#
# Expo SDK 56+ installs its own "expo/fetch" as the global fetch by default,
# which has an unresolved FormData bug ("Unsupported FormDataPart
# implementation" - https://github.com/expo/expo/issues/33134) that broke
# EVERY fetch() call in this app, not just FormData uploads. This reverts to
# React Native's classic XMLHttpRequest-based fetch. See ERROR_LOG.md
# (2026-07-20).
EXPO_PUBLIC_USE_RN_FETCH=1
